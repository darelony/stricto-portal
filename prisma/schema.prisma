// SafeTrack – OHS (BZR) client portal data model.
// Legal intervals are never hard-coded: they live in IntervalSetting rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  ADMIN
  CONSULTANT
  CLIENT_ADMIN
  CLIENT_VIEWER
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum TrainingType {
  INITIAL
  PERIODIC
  TRANSFER
  NEW_EQUIPMENT
  FIRE_SAFETY
  FIRST_AID
}

enum MedicalExamType {
  PRELIMINARY
  PERIODIC
}

enum MedicalResult {
  FIT
  FIT_WITH_RESTRICTIONS
  UNFIT
}

enum EnvParameter {
  MICROCLIMATE
  LIGHTING
  NOISE
  VIBRATION
  CHEMICAL
  BIOLOGICAL
  DUST
  ELECTRICAL_INSTALLATION
  LIGHTNING_PROTECTION
  OTHER
}

enum TestResult {
  COMPLIANT
  NON_COMPLIANT
  PARTIALLY_COMPLIANT
}

enum InspectionResult {
  SAFE
  UNSAFE
  NOT_INSPECTED
}

enum RiskAssessmentStatus {
  DRAFT
  ADOPTED
  UNDER_REVIEW
  ARCHIVED
}

enum InjurySeverity {
  LIGHT
  SERIOUS
  FATAL
  COLLECTIVE
}

enum ObligationType {
  TRAINING
  FIRE_SAFETY_TRAINING
  FIRST_AID_TRAINING
  MEDICAL_EXAM
  EQUIPMENT_INSPECTION
  ENVIRONMENT_TEST
  RISK_ASSESSMENT_REVIEW
  PPE_REPLACEMENT
  OTHER
}

enum ObligationStatus {
  UPCOMING
  DUE_SOON
  OVERDUE
  DONE
}

enum SourceEntity {
  TRAINING
  MEDICAL_EXAM
  EQUIPMENT
  ENVIRONMENT_TEST
  RISK_ASSESSMENT
  PPE_ISSUE
  MANUAL
}

enum DocumentCategory {
  RISK_ASSESSMENT
  RECORDS
  TRAINING
  INSPECTION
  INJURY
  CONTRACT
  INVOICE
  OTHER
}

enum RequestCategory {
  NEW_EMPLOYEE
  TRAINING
  INSPECTION
  INJURY
  QUESTION
  OTHER
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

enum LeadStatus {
  NEW
  CONTACTED
  OFFER_SENT
  WON
  LOST
}

// Keys of configurable legal intervals (see IntervalSetting).
enum IntervalKey {
  TRAINING_PERIODIC
  TRAINING_PERIODIC_HIGH_RISK
  TRAINING_FIRE_SAFETY
  TRAINING_FIRST_AID
  MEDICAL_PERIODIC
  MEDICAL_PERIODIC_HIGH_RISK
  EQUIPMENT_INSPECTION
  ENVIRONMENT_TEST
  RISK_ASSESSMENT_REVIEW
  PPE_REPLACEMENT
}

// ─────────────────────────────── Auth ───────────────────────────────

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  role                  Role      @default(CLIENT_VIEWER)
  companyId             String?
  company               Company?  @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: SetNull)
  phone                 String?
  active                Boolean   @default(true)
  lastLoginAt           DateTime?
  // Email notification preferences
  notifyDeadlines       Boolean   @default(true)
  notifyRequests        Boolean   @default(true)
  notifyMessages        Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  assignedCompanies     Company[]       @relation("AssignedConsultant")
  assignedRequests      Request[]       @relation("RequestAssignee")
  createdRequests       Request[]       @relation("RequestCreator")
  messages              Message[]
  notifications         Notification[]
  activityLogs          ActivityLog[]
  uploadedFiles         StoredFile[]
  uploadedDocuments     Document[]
  invitesSent           Invite[]
  passwordResetTokens   PasswordResetToken[]
  reminderLogs          ReminderLog[]
  reportedInjuries      Injury[]

  @@index([companyId])
  @@index([role])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  name        String?
  role        Role
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String?
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ─────────────────────────────── Client companies ───────────────────────────────

model Company {
  id                    String        @id @default(cuid())
  name                  String
  pib                   String        @unique
  mb                    String?
  activityCode          String?
  industry              String?
  address               String?
  city                  String?
  contactPerson         String?
  phone                 String?
  email                 String?
  employeeCount         Int?
  assignedConsultantId  String?
  assignedConsultant    User?         @relation("AssignedConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  contractStart         DateTime?
  contractEnd           DateTime?
  status                CompanyStatus @default(ACTIVE)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  users                 User[]        @relation("CompanyUsers")
  invites               Invite[]
  locations             Location[]
  workplaces            Workplace[]
  employees             Employee[]
  equipment             Equipment[]
  environmentTests      EnvironmentTest[]
  riskAssessments       RiskAssessment[]
  injuries              Injury[]
  obligations           Obligation[]
  documents             Document[]
  requests              Request[]
  files                 StoredFile[]
  activityLogs          ActivityLog[]
  convertedFromLeads    Lead[]

  @@index([assignedConsultantId])
  @@index([status])
}

model Location {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  address          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  employees        Employee[]
  equipment        Equipment[]
  environmentTests EnvironmentTest[]
  obligations      Obligation[]
  injuries         Injury[]

  @@index([companyId])
}

model Workplace {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isHighRisk  Boolean    @default(false)
  hazards     String?
  requiredPpe String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employees   Employee[]

  @@index([companyId])
}

model Employee {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId          String?
  location            Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workplaceId         String?
  workplace           Workplace?    @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  firstName           String
  lastName            String
  // AES-256-GCM ciphertext of the personal ID number (JMBG); never stored in plain text.
  personalIdEncrypted String?
  email               String?
  phone               String?
  hireDate            DateTime?
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  trainings           Training[]
  medicalExams        MedicalExam[]
  ppeIssues           PPEIssue[]
  injuries            Injury[]
  obligations         Obligation[]

  @@index([companyId])
  @@index([companyId, lastName])
}

// ─────────────────────────────── OHS records ───────────────────────────────

model Training {
  id                String       @id @default(cuid())
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type              TrainingType
  date              DateTime
  validUntil        DateTime?
  trainer           String?
  notes             String?
  // Groups records created together in one bulk training session.
  sessionId         String?
  certificateFileId String?      @unique
  certificateFile   StoredFile?  @relation("TrainingCertificate", fields: [certificateFileId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([employeeId])
  @@index([sessionId])
}

model MedicalExam {
  id           String          @id @default(cuid())
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         MedicalExamType
  date         DateTime
  validUntil   DateTime?
  result       MedicalResult
  restrictions String?
  reportFileId String?         @unique
  reportFile   StoredFile?     @relation("MedicalReport", fields: [reportFileId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([employeeId])
}

model Equipment {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId      String?
  location        Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name            String
  type            String?
  serialNumber    String?
  inventoryNumber String?
  lastInspection  DateTime?
  nextInspection  DateTime?
  lastResult      InspectionResult  @default(NOT_INSPECTED)
  reportFileId    String?           @unique
  reportFile      StoredFile?       @relation("EquipmentReport", fields: [reportFileId], references: [id], onDelete: SetNull)
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([companyId])
}

model EnvironmentTest {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId   String?
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parameters   EnvParameter[]
  date         DateTime
  nextDate     DateTime?
  result       TestResult
  notes        String?
  reportFileId String?        @unique
  reportFile   StoredFile?    @relation("EnvironmentReport", fields: [reportFileId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([companyId])
}

model RiskAssessment {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  version        String
  adoptedAt      DateTime?
  nextReviewAt   DateTime?
  status         RiskAssessmentStatus @default(DRAFT)
  changesSummary String?
  documentFileId String?              @unique
  documentFile   StoredFile?          @relation("RiskAssessmentDocument", fields: [documentFileId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([companyId])
}

model Injury {
  id                      String         @id @default(cuid())
  companyId               String
  company                 Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId              String?
  employee                Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  locationId              String?
  location                Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  occurredAt              DateTime
  place                   String
  description             String
  witnesses               String?
  severity                InjurySeverity
  reportedToInspectionAt  DateTime?
  followUpActions         String?
  reportFileId            String?        @unique
  reportFile              StoredFile?    @relation("InjuryReport", fields: [reportFileId], references: [id], onDelete: SetNull)
  reportedById            String?
  reportedBy              User?          @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  request                 Request?
  attachments             Attachment[]

  @@index([companyId])
}

model PPEIssue {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  item       String
  quantity   Int       @default(1)
  issuedAt   DateTime
  replaceBy  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId])
}

// Generic deadline. One row per source record (unique sourceEntity+sourceId);
// when a newer record of the same kind is saved, older obligations are closed (DONE).
model Obligation {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationId   String?
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type         ObligationType
  title        String
  dueDate      DateTime
  status       ObligationStatus @default(UPCOMING)
  completedAt  DateTime?
  sourceEntity SourceEntity
  sourceId     String
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reminderLogs ReminderLog[]

  @@unique([sourceEntity, sourceId])
  @@index([companyId, status])
  @@index([dueDate])
}

model ReminderLog {
  id           String     @id @default(cuid())
  obligationId String
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Offset in days that triggered the reminder; -1 means "became overdue".
  offsetDays   Int
  sentAt       DateTime   @default(now())

  @@unique([obligationId, userId, offsetDays])
}

// ─────────────────────────────── Files & documents ───────────────────────────────

model StoredFile {
  id            String    @id @default(cuid())
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  storageKey    String    @unique
  filename      String
  mimeType      String
  size          Int
  // Health data: visible only to staff and CLIENT_ADMIN of the company; access is logged.
  medical       Boolean   @default(false)
  // When false, only ADMIN/CONSULTANT may download.
  clientVisible Boolean   @default(true)
  uploadedById  String?
  uploadedBy    User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  trainingCertificate   Training?        @relation("TrainingCertificate")
  medicalReport         MedicalExam?     @relation("MedicalReport")
  equipmentReport       Equipment?       @relation("EquipmentReport")
  environmentReport     EnvironmentTest? @relation("EnvironmentReport")
  riskAssessmentDoc     RiskAssessment?  @relation("RiskAssessmentDocument")
  injuryReport          Injury?          @relation("InjuryReport")
  document              Document?
  attachment            Attachment?

  @@index([companyId])
}

model Document {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        DocumentCategory
  title           String
  description     String?
  fileId          String           @unique
  file            StoredFile       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  visibleToClient Boolean          @default(true)
  uploadedById    String?
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId, category])
}

// ─────────────────────────────── Requests & messaging ───────────────────────────────

model Request {
  id           String          @id @default(cuid())
  number       String          @unique
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String
  category     RequestCategory
  priority     RequestPriority @default(NORMAL)
  status       RequestStatus   @default(NEW)
  assignedToId String?
  assignedTo   User?           @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?           @relation("RequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  injuryId     String?         @unique
  injury       Injury?         @relation(fields: [injuryId], references: [id], onDelete: SetNull)
  employeeId   String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  messages     Message[]
  attachments  Attachment[]

  @@index([companyId, status])
  @@index([assignedToId])
}

model Message {
  id          String       @id @default(cuid())
  requestId   String
  request     Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body        String
  // Internal notes are visible only to ADMIN/CONSULTANT.
  isInternal  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  attachments Attachment[]

  @@index([requestId])
}

model Attachment {
  id        String     @id @default(cuid())
  fileId    String     @unique
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  requestId String?
  request   Request?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message?   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  injuryId  String?
  injury    Injury?    @relation(fields: [injuryId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  summary   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────── Website leads ───────────────────────────────

model Lead {
  id                 String     @id @default(cuid())
  companyName        String
  pib                String?
  industry           String?
  employeeCount      Int?
  locationCount      Int?
  services           String[]
  message            String?
  contactName        String
  email              String
  phone              String?
  status             LeadStatus @default(NEW)
  notes              String?
  source             String     @default("website")
  convertedCompanyId String?
  convertedCompany   Company?   @relation(fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────────────── Settings ───────────────────────────────

// Configurable legal intervals. months = null means "no automatic expiry".
model IntervalSetting {
  key         IntervalKey @id
  label       String
  months      Int?
  description String?
  updatedAt   DateTime    @updatedAt
}

// Singleton row (id = 1).
model AppSettings {
  id              Int      @id @default(1)
  companyName     String   @default("[NAZIV FIRME]")
  companyAddress  String?
  companyCity     String?
  companyPhone    String?
  companyEmail    String?
  companyPib      String?
  companyMb       String?
  companyWebsite  String?
  logoFileId      String?
  emailFooter     String?
  // Days before due date at which reminders are sent, e.g. [60, 30, 7].
  reminderOffsets Int[]    @default([60, 30, 7])
  updatedAt       DateTime @updatedAt
}

model Counter {
  key   String @id
  value Int
}
