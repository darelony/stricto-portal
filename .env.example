# ─────────────────────────────────────────────────────────────────────────────
# SafeTrack – environment variables
# Copy to .env.local for development (never commit real values).
# On Vercel, set the same variables in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL.
# DATABASE_URL: the POOLED connection string (host contains "-pooler"), used by the app.
# DIRECT_URL:   the DIRECT (non-pooled) connection string, used by Prisma migrations.
# For local development use a separate Neon branch (e.g. "dev").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/safetrack?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/safetrack?sslmode=require"

# Neon branch used ONLY by Playwright e2e tests. It is reset and re-seeded before every
# test run — never point it at production or dev data.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-test-xxxx.eu-central-1.aws.neon.tech/safetrack?sslmode=require"

# Auth.js – generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public base URL of the app (no trailing slash). Used in emails and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# AES-256-GCM key for personal ID numbers (JMBG) at rest. 32 bytes, base64.
# Generate with: openssl rand -base64 32
# WARNING: changing it makes previously encrypted values unreadable.
ENCRYPTION_KEY=""

# Resend (transactional email + magic links). Without RESEND_API_KEY emails are printed
# to the server console instead of being sent (handy for local development).
RESEND_API_KEY=""
# Verified sender in Resend, e.g. "SafeTrack <portal@vasafirma.rs>"
EMAIL_FROM="SafeTrack <onboarding@resend.dev>"
# Where website quote requests are emailed (comma-separated). Falls back to all admins.
LEADS_NOTIFY_EMAIL=""

# Vercel Blob (private file storage). Created automatically when you connect a Blob store
# in Vercel. Without it, files are stored in ./.uploads (local development only).
BLOB_READ_WRITE_TOKEN=""

# Protects /api/cron/reminders. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Public website: name of the consulting company (until real data is filled in).
NEXT_PUBLIC_COMPANY_NAME="[NAZIV FIRME]"

# Seed: initial admin credentials created by `pnpm db:seed` (change after first login).
SEED_ADMIN_EMAIL="admin@safetrack.local"
SEED_ADMIN_PASSWORD="Promeni-me-2026"
